rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario autenticado solo puede leer/escribir sus propios datos,
    // aislados por uid. Nadie puede ver ni tocar los datos de otro usuario.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
